{
  "name": "tokencontrol",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace @tokencontrol/shared && npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
